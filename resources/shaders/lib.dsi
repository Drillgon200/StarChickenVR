struct M4x3F {
	V4F row0;
	V4F row1;
	V4F row2;
};

struct Camera {
	M4x3F worldToView;
	F32 projXScale;
	F32 projXZBias;
	F32 projYScale;
	F32 projYZBias;
	V3F position;
	V3F direction;
};

struct Material {
	I32 baseColorIdx;
	I32 normalMapIdx;
	I32 armMapIdx;
	U32 packedBaseColor;
	U32 packedARMI;
};

struct Light {
	V3F pos;
	V3F direction;
	V3F color;
	U32 packedCullRadiusAndType; // Normalized cull radius (*1024) in upper 30 bits and light type in bottom two bits
};

// See DOOM 2016's rendering presentations
// Perhaps I'll try implementing DOOM Eternal's tile + cluster hybrid approach at some point, but this is easier for now
struct ClusterBin {
	U32 lightCount; // Would also have packed decal and reflection probe counts
};

struct ClusterItem {
	U32 lightIdx; // Would also contain decal and reflection probe index
};

[block] struct DrawData {
	V2F screenDimensions;
	&V4F uiClipBoxes;
	V2U pUIVertices;
	&M4x3F matrices;
	&V3F positions;
	&V2F texcoords;
	&V3F normals;
	&V3F tangents;
	&U32 boneIndicesAndWeights;
	&V3F skinnedPositions;
	&V3F skinnedNormals;
	&V3F skinnedTangents;
	&Material materials;
	&Camera cams;
	&Light lights;
	&ClusterBin clusterBins;
	&ClusterItem clusterItems;
	V2F clusterScaleBias;
	U32 lightCount;
};

[block] struct WorldDrawPushConstants {
	U32 transformIdx;
	I32 verticesOffset;
	U32 camIdx;
	U32 objId; // High bit set if selected
	U32 materialId;
	U32 debugMode;
};